# Copia este archivo como .env y rellena los valores.
# NUNCA uses valores reales aquí: .env.example sí se versione.
# Ruta ABSOLUTA al JSON del service account, guardado FUERA del repositorio.
GOOGLE_APPLICATION_CREDENTIALS=/ruta/absoluta/fuera/del/repo/service-account.json
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
PORT=3000
# Cookie Secure para la sesión de admin (true en producción con HTTPS)
# COOKIE_SECURE=true
# Ruta de la base de datos SQLite (producción). Por defecto: rifa.db junto a server.js
# RIFA_DATABASE_PATH=/var/lib/rifa/rifa.db
