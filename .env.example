# Copia este archivo como .env y rellena los valores.
# NUNCA uses valores reales aquí: .env.example sí se versione.
#
# Credenciales de Firebase Admin: cada propiedad del JSON del service account
# como variable de entorno (no se necesita archivo JSON en el servidor).
# Los valores salen del JSON descargado de Firebase Console → Cuentas de servicio.
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_PRIVATE_KEY_ID=abc123def456
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto-firebase.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=123456789012345678901
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40tu-proyecto-firebase.iam.gserviceaccount.com
FIREBASE_UNIVERSE_DOMAIN=googleapis.com
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app

# NOTA: en FIREBASE_PRIVATE_KEY los saltos de línea del PEM van escapados como
# \n literales en UNA sola línea (el backend los decodifica automáticamente).

PORT=3000
# Cookie Secure para la sesión de admin (true en producción con HTTPS)
# COOKIE_SECURE=true
# Ruta de la base de datos SQLite (producción). Por defecto: rifa.db junto a server.js
# RIFA_DATABASE_PATH=/var/lib/rifa/rifa.db
